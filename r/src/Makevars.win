CARGO ?= cargo
TARGET_DIR = rust/target
LIBDIR = $(TARGET_DIR)/release
STATLIB = $(LIBDIR)/librapidxlsx_r.a

PKG_LIBS = -L$(LIBDIR) -lrapidxlsx_r -lws2_32 -luserenv -lbcrypt -lntdll

all: $(SHLIB)

$(SHLIB): $(STATLIB)

$(STATLIB):
	rustc --version
	@mkdir -p $(TARGET_DIR)
	CARGO_TARGET_DIR=$(TARGET_DIR) $(CARGO) build --release --manifest-path=rust/Cargo.toml

clean:
	rm -rf $(TARGET_DIR)
